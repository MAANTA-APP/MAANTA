# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
#
# `.env*.local` alone does not match a plain `.env` or `.env.production` — both
# common local filenames — so those were one `git add -A` away from committing
# live credentials (SEC-009). Ignore every .env variant and re-admit the one
# file that is meant to be tracked.
.env
.env.*
!.env.example
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
supabase/.temp/

# Playwright storage states are live sessions on production identities — never
# tracked, whatever they are called. The capture script writes outside the repo
# (os.tmpdir()) but a hand-run `playwright open --save-storage` lands here.
admin.json
cofounder.json
shopper.json
merchant.json
*.storage-state.json
/playwright-report.json
/playwright-report/
/test-results/
