# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (authentication layer — wired in as a Supabase third-party auth
# provider; see docs/skills/clerk-auth.md for the required dashboard steps).
# Keys are per-instance, from the Clerk dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Route wiring — these match the /login and /sign-up catch-all routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/select-mall
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/select-mall

# Twilio Verify (was Supabase Auth SMS config; phone OTP now runs through
# Clerk. Retained only if referenced elsewhere — not used in app code.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# what3words
W3W_API_KEY=

# PostHog (server-side product analytics — Guardian outcomes, etc.).
# Server capture is OFF unless POSTHOG_PROJECT_KEY is set, so leaving these
# blank is safe (dev/CI emit nothing). Use the PostHog *project* key (phc_...).
# Host defaults to https://eu.i.posthog.com (EU cloud) when unset.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=

# IntaSend (M-Pesa STK)
INTASEND_API_KEY=
INTASEND_SECRET=
INTASEND_WEBHOOK_SECRET=
# "live" to hit https://payment.intasend.com, anything else (incl. unset) uses sandbox
INTASEND_ENV=

# Stripe (secondary card top-up option; M-Pesa via IntaSend is primary.
# Note: Stripe has no native Kenya payout support — a Kenya-incorporated
# entity needs a foreign bank account for Stripe payouts, or a Kenya-capable
# processor like Paystack/Flutterwave. Revisit at incorporation.)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "live" to allow real charges, anything else (incl. unset) requires a test key
STRIPE_ENV=

# Resend (waitlist contacts + confirmation emails; contacts live in a
# Resend audience per docs/maanta-waitlist-data-schema.md)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# e.g. "MAANTA <hello@maanta.app>" — domain must be verified in Resend
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=https://maanta.app
NODE_ENV=development

# Web Push (VAPID — generate via `node -e "console.log(require('web-push').generateVAPIDKeys())"`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@maanta.app
