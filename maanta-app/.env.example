# Auth strategy (rehearsal vs launch)
# supabase — default: email OTP via Supabase Auth (production rehearsal)
# clerk    — launch only: Clerk email + phone OTP (set BOTH vars below explicitly)
# authjs   — reserved; behaves like supabase until Auth.js is wired
# Leave unset or set to supabase for rehearsal. Set BOTH to clerk at launch.
MAANTA_AUTH_STRATEGY=supabase
NEXT_PUBLIC_MAANTA_AUTH_STRATEGY=supabase

# ═══════════════════════════════════════════════════════════════════════════
# MINIMUM PRODUCTION ENV (Vercel → Production) — names only, no secrets
# Full audit: docs/ops/backend-prod-setup-status-2026-07.md
# Founder paste checklist: docs/ops/founder-backend-prod-checklist-2026-07.md
#
# required-now:
#   NEXT_PUBLIC_SUPABASE_URL              → https://axrrslqssmbngbataejg.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY             → server-only
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY     → Production pk_live_…
#   CLERK_SECRET_KEY                      → matching sk_live_… (server-only)
#   NEXT_PUBLIC_APP_URL                   → https://www.maanta.app
#   MAANTA_AUTH_STRATEGY                  → clerk
#   NEXT_PUBLIC_MAANTA_AUTH_STRATEGY      → clerk  (must match; redeploy after change)
#
# required-soon (monitoring / waitlist / maps / money):
#   SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN
#   POSTHOG_PROJECT_KEY, NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN, POSTHOG_HOST
#   RESEND_API_KEY, RESEND_AUDIENCE_ID, RESEND_FROM_EMAIL
#   W3W_API_KEY
#   STRIPE_* / INTASEND_* only when testing or going live on that rail
#
# NEXT_PUBLIC_* values are baked into the client bundle — redeploy after changes.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (required for any DB-backed page or API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=                         # Project URL (e.g. https://<ref>.supabase.co). Required for dev with real data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=                    # Publishable/anon key. Required for dev with real data.
SUPABASE_SERVICE_ROLE_KEY=                          # Service-role secret (server only). Required for most API routes and SSR pages.

# ── Clerk auth (required for dev server beyond static marketing pages) ────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=                  # Clerk publishable key. Required for dev with login.
CLERK_SECRET_KEY=                                   # Clerk secret key. Required for dev with login.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login                # Sign-in route. Optional — these defaults match the app.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up              # Sign-up route. Optional.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app-bootstrap  # Post-login redirect (role router). Optional.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app-bootstrap  # Post-signup redirect (role router). Optional.
NEXT_PUBLIC_LAUNCH_AUTH_MODE=email_and_phone        # Launch sign-up mix: email_and_phone | phone_only. Optional (defaults to email_and_phone).

# ── Pilot booking (optional — CTA falls back to the contact form when unset) ─
NEXT_PUBLIC_PILOT_BOOKING_URL=                      # Founder-configured Calendly event URL (https://calendly.com/…) that creates a Google Meet link after booking. When unset, "Book a pilot conversation" is not published; pages show "Start a pilot conversation" → /contact instead.

# ── App origin ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000           # Canonical public URL (Stripe redirects, etc.). Optional in dev (falls back to localhost:3000).
NODE_ENV=development                                # Set automatically by Next.js; only document for clarity.

# ── Stripe (card top-up — optional unless testing /merchant/topup card flow) ─
STRIPE_SECRET_KEY=                                  # Stripe secret key (sk_test_… or sk_live_…). Required only for card top-up.
STRIPE_WEBHOOK_SECRET=                              # Stripe webhook signing secret. Required only for /api/webhooks/stripe.
STRIPE_ENV=                                         # "live" for real charges; unset or anything else = test-mode guard. Optional in dev.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=               # LEGACY/UNUSED — Stripe Checkout is server-initiated; not referenced in app code.

# ── IntaSend / M-Pesa STK (optional unless testing M-Pesa top-up) ────────
INTASEND_API_KEY=                                   # IntaSend public key. Required for /api/topup (M-Pesa).
INTASEND_SECRET=                                    # IntaSend secret key. Required for /api/topup.
INTASEND_WEBHOOK_SECRET=                            # Webhook challenge secret. Required for /api/webhooks/intasend.
INTASEND_ENV=                                       # "live" for production API; unset = sandbox. Optional in dev.

# ── Sentry (optional — no-ops when unset) ─────────────────────────────────
SENTRY_DSN=                                         # Server/edge DSN. Optional in dev.
NEXT_PUBLIC_SENTRY_DSN=                             # Browser DSN. Optional in dev.
SENTRY_AUTH_TOKEN=                                  # CI/deploy only — source-map upload. Not needed locally.

# ── PostHog (optional — analytics disabled when unset) ────────────────────
POSTHOG_PROJECT_KEY=                                # Server-side project key (phc_…). Optional in dev.
POSTHOG_HOST=https://eu.i.posthog.com               # PostHog ingest host. Optional (defaults to EU cloud).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=                  # Client-side project token for posthog-js. Optional in dev.

# ── Resend / waitlist (optional unless testing /waitlist) ─────────────────
RESEND_API_KEY=                                     # Resend API key. Required for waitlist signups.
RESEND_AUDIENCE_ID=                                 # Resend audience/list ID. Required for waitlist signups.
RESEND_FROM_EMAIL=                                  # Verified sender, e.g. "MAANTA <hello@mail.maanta.app>". Required for waitlist emails.
WAITLIST_TEST_TOKEN=                                # Optional. Enables /waitlist?test=<token> internal TEST signups. Must be at least 32 characters or it is ignored (fails closed).
# RESEND_BASE_URL=https://api.resend.com            # Optional — override for local Resend mock.

# ── Web Push (optional unless testing /feed notification opt-in) ───────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                       # VAPID public key (browser subscription). Optional in dev.
VAPID_PRIVATE_KEY=                                  # VAPID private key (server send). Optional in dev.
VAPID_SUBJECT=mailto:admin@maanta.app               # VAPID contact URI. Optional (has default).

# ── what3words (optional unless testing merchant onboard / w3w validate) ────
W3W_API_KEY=                                        # what3words API key. Optional in dev (/api/w3w/validate has a dev fallback).

# ── Legacy / unused (phone OTP moved to Clerk — not referenced in app code) ─
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ── E2E / Playwright only (not needed for npm run dev) ────────────────────
# E2E_BASE_URL=http://localhost:3000
# E2E_SHOPPER_STORAGE=./e2e/.auth/shopper.json
# E2E_MERCHANT_STORAGE=./e2e/.auth/merchant.json
# E2E_DEAL_PATH=/deals/<deal-id>
