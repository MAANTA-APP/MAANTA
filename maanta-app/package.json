{
  "name": "maanta-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build && npm run check:tokens && npm run check:canonicals && npm run check:forms",
    "check:tokens": "node scripts/check-tokens.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:clerk-smoke": "vitest run src/__smoke__/clerk",
    "test:e2e": "playwright test",
    "check:canonicals": "node scripts/check-canonicals.mjs",
    "check:forms": "node scripts/check-server-forms.mjs",
    "brand:icons": "node scripts/write-brand-icons.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "leaflet": "^1.9.4",
    "next": "16.3.1",
    "posthog-js": "^1.406.2",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "stripe": "^22.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
