# E2E environment for the Playwright golden-path suite.
# Copy to `maanta-app/.env.e2e` (gitignored) and fill in TEST-instance values.
# These point the suite at a live TEST Supabase + Clerk — never production.

# App under test. If set, the suite runs against this URL (e.g. a Vercel preview)
# and does NOT boot a local server. If unset, playwright.config boots `next start`
# on http://127.0.0.1:3000 using the vars below.
E2E_BASE_URL=

# Supabase (test project). The service-role key is used by the tests ONLY for
# arrange/assert (reset wallets, drive the top-up RPC, read balances) — never by
# the app under test.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (TEST instance). The secret key is used by the app, by @clerk/testing's
# Testing Token, and by the Clerk↔Supabase user-linking step in globalSetup.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/select-mall
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/select-mall

# Seeded logins — override with your Clerk TEST users. Clerk `+clerk_test`
# addresses accept the fixed OTP below and are never actually emailed.
E2E_SHOPPER_EMAIL=aragagency+shopper@gmail.com
E2E_MERCHANT_NUUR_EMAIL=aragagency+nuur@gmail.com
E2E_MERCHANT_BILAN_EMAIL=aragagency+bilan@gmail.com
E2E_OTP_CODE=424242

# Optional overrides if you re-seeded with different ids / prices.
# E2E_GOLDEN_DEAL_ID=d0000000-0000-4000-a000-000000000001
# E2E_GOLDEN_DEAL_PAY=2400
# E2E_MERCHANT_NUUR_ID=c0000000-0000-4000-a000-000000000001
# E2E_MERCHANT_BILAN_ID=c0000000-0000-4000-a000-000000000002
# E2E_SUCCESS_FEE=30
